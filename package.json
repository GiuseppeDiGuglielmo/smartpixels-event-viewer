{
  "name": "smartpixels-event-viewer",
  "version": "0.10.0",
  "private": true,
  "description": "Interactive 2D and 3D viewer for PixelAV-simulated smart-pixel events (Three.js r187 vendored, no npm install)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "sample": "node scripts/dev-server.mjs --sample",
    "test": "node --test tests/*.test.js",
    "check": "npm test",
    "convert:pixelav": "python3 scripts/pixelav_convert.py",
    "test:converter": "python3 scripts/test_pixelav_convert.py",
    "qa:browser": "node scripts/qa-browser.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
